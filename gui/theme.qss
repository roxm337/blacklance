/* ============================================================================
   OSINT Agent — quiet operations theme
   Tokens (kept in sync with gui/app.py color maps):
     bg          #0a0f14   window
     surface     #111820   panels / group boxes
     surface-2   #151e27   raised controls / selected rows
     sunken      #0c1218   inputs, wells, table rows
     border      #25313c   structural edges
     text        #d8e2ea   body
     text-bright #f3f7fa   headings
     muted       #82919e   captions
     accent      #35c7b1   active state / focus rings
     accent-mid  #229c8b   primary fills
     ok          #4ade80   warn #fbbf24   danger #f87171   info #7dd3fc
   ========================================================================= */

/* ── Base ─────────────────────────────────────────────────────────────── */

QMainWindow {
    background: #0a0f14;
}

QWidget {
    color: #d8e2ea;
    font-size: 13px;
}

QLabel {
    background: transparent;
}

#title {
    color: #f3f7fa;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 1px;
}

#subtitle {
    color: #82919e;
    font-size: 12px;
}

#sectionCaption {
    color: #93a3b0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ── Header context chips ─────────────────────────────────────────────── */

#topBar {
    background: #111820;
    border: 1px solid #25313c;
    border-radius: 8px;
}

#contextChip {
    color: #a6b4bf;
    background: #0c1218;
    border: 1px solid #2a3743;
    border-radius: 10px;
    padding: 4px 11px;
    font-size: 11px;
    font-weight: 600;
}

#contextChip:hover {
    color: #e4ebf0;
    border-color: #47606c;
}

/* ── Status pill (header) — state variants ────────────────────────────── */

#status {
    padding: 7px 14px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 12px;
    min-width: 64px;
}

#status[state="idle"] {
    color: #a6b4bf;
    background: #0c1218;
    border: 1px solid #32404d;
}

#status[state="busy"] {
    color: #83eadb;
    background: #102b29;
    border: 1px solid #257b70;
}

#status[state="ok"] {
    color: #bbf7d0;
    background: #0f2318;
    border: 1px solid #166534;
}

#status[state="error"] {
    color: #fecdd3;
    background: #2a0f16;
    border: 1px solid #7f1d1d;
}

/* ── Status bar ───────────────────────────────────────────────────────── */

QStatusBar {
    background: #0c1218;
    border-top: 1px solid #25313c;
    color: #82919e;
    font-size: 11px;
}

#statusBarLabel {
    color: #82919e;
    font-size: 11px;
}

/* ── Icon nav rail ────────────────────────────────────────────────────── */

#navRail {
    background: #111820;
    border: 1px solid #25313c;
    border-radius: 9px;
}

QToolButton#navButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    color: #94a4b0;
    padding: 8px 2px 6px 2px;
    font-size: 10px;
    font-weight: 700;
}

QToolButton#navButton:hover {
    background: #18232d;
    color: #e5ecef;
}

QToolButton#navButton:checked {
    background: #14302e;
    border: 1px solid #267c70;
    color: #8cebdd;
}

/* ── Screens & stacking ───────────────────────────────────────────────── */

#screenStack {
    background: transparent;
}

#screenRun, #screenTriage, #screenGraph, #screenData, #screenReport {
    background: transparent;
}

/* ── Panels ───────────────────────────────────────────────────────────── */

#sidePanel, #sideScroll, QGroupBox, QTabWidget::pane {
    background: #111820;
    border: 1px solid #25313c;
    border-radius: 7px;
}

#sideScroll {
    border: 0;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollArea {
    background: transparent;
    border: 0;
}

QGroupBox {
    margin-top: 12px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
    color: #f1f5f9;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #70daca;
    background: #111820;
}

/* ── Ops strip + metrics ──────────────────────────────────────────────── */

#opsStrip {
    background: #111820;
    border: 1px solid #25313c;
    border-left: 3px solid #35c7b1;
    border-radius: 7px;
}

#opsPrimary {
    color: #f3f7fa;
    font-size: 15px;
    font-weight: 700;
}

#opsSecondary {
    color: #93a3b0;
    font-size: 11px;
}

/* Ops badge — same state language as the header pill. */

#opsState {
    padding: 7px 12px;
    border-radius: 5px;
    font-weight: 700;
    font-size: 12px;
}

#opsState[state="idle"] {
    color: #a6b4bf;
    background: #0c1218;
    border: 1px solid #32404d;
}

#opsState[state="busy"] {
    color: #83eadb;
    background: #102b29;
    border: 1px solid #257b70;
}

#opsState[state="ok"] {
    color: #bbf7d0;
    background: #0f2318;
    border: 1px solid #166534;
}

#opsState[state="error"] {
    color: #fecdd3;
    background: #2a0f16;
    border: 1px solid #7f1d1d;
}

#metricCard {
    background: #0f161d;
    border: 1px solid #25313c;
    border-radius: 7px;
    padding: 10px;
}

#metricCard[tone="danger"] {
    border-color: #7f1d1d;
}

#metricCard[tone="warning"] {
    border-color: #92400e;
}

#metricCard[tone="success"] {
    border-color: #166534;
}

#metricCard[tone="info"] {
    border-color: #1e40af;
}

#metricLabel {
    color: #82919e;
    font-size: 10px;
    font-weight: 700;
}

#metricValue {
    color: #f3f7fa;
    font-size: 18px;
    font-weight: 800;
}

/* ── Input controls ───────────────────────────────────────────────────── */

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QPlainTextEdit, QTextEdit, QTableWidget, QTableView {
    background: #0c1218;
    border: 1px solid #32404d;
    border-radius: 5px;
    color: #e5ecef;
    padding: 6px;
    selection-background-color: #1b7469;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #35c7b1;
    background: #0c1218;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background: #111820;
    color: #5b6a80;
    border-color: #1c2739;
}

QComboBox::drop-down {
    border: 0;
    width: 20px;
    background: transparent;
}

QComboBox QAbstractItemView {
    background: #111820;
    border: 1px solid #32404d;
    color: #e5ecef;
    selection-background-color: #1b7469;
    selection-color: #ffffff;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    min-height: 22px;
}

#filterCombo {
    background: #0c1218;
    border: 1px solid #32404d;
    border-radius: 5px;
    padding: 6px 9px;
    font-weight: 600;
    color: #cbd5e1;
    min-width: 120px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 17px;
    border: 0;
    border-left: 1px solid #32404d;
    border-bottom: 1px solid #32404d;
    background: #151e27;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 17px;
    border: 0;
    border-left: 1px solid #32404d;
    background: #151e27;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #20303a;
}

/* ── Tables ───────────────────────────────────────────────────────────── */

QTableWidget, QTableView {
    gridline-color: #172233;
    alternate-background-color: #101820;
}

QTableWidget::item, QTableView::item {
    border-bottom: 1px solid #141e2e;
    padding: 4px;
}

QTableWidget::item:hover, QTableView::item:hover {
    background: #18232d;
}

QTableWidget::item:selected, QTableView::item:selected {
    background: #163b38;
    color: #eafffb;
}

QHeaderView {
    background: #0c1218;
}

QHeaderView::section {
    background: #151e27;
    border: 0;
    border-right: 1px solid #26364c;
    border-bottom: 1px solid #26364c;
    color: #a6b4bf;
    padding: 8px 7px;
    font-weight: 700;
    font-size: 11px;
}

QHeaderView::section:hover {
    background: #1b2832;
    color: #d8e2ea;
}

QTableView::corner {
    background: #151e27;
    border: 0;
    border-right: 1px solid #26364c;
    border-bottom: 1px solid #26364c;
}

QHeaderView::down-arrow, QHeaderView::up-arrow {
    width: 8px;
    height: 8px;
}

/* ── Scrollbars (vertical + horizontal) ───────────────────────────────── */

QScrollBar:vertical {
    background: #0c1218;
    width: 10px;
    margin: 0;
    border: 0;
}

QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar:horizontal {
    background: #0c1218;
    height: 10px;
    margin: 0;
    border: 0;
}

QScrollBar::handle:horizontal {
    background: #334155;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #475569;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    border: 0;
}

QScrollBar::corner {
    background: #0c1218;
}

/* ── Buttons — neutral base, clear hierarchy ──────────────────────────── */

QPushButton {
    background: #18232d;
    color: #d8e2ea;
    border: 1px solid #32404d;
    border-radius: 6px;
    padding: 8px 13px;
    font-weight: 600;
    min-width: 0;
}

QPushButton:hover:!disabled {
    background: #20303a;
    border-color: #47606c;
}

QPushButton:pressed:!disabled {
    background: #0f171e;
}

QPushButton:disabled {
    background: #111820;
    border-color: #1c2739;
    color: #5b6a80;
}

QPushButton:default {
    border-color: #35c7b1;
}

#btnPrimary {
    background: #229c8b;
    border-color: #35c7b1;
    color: #f5fffd;
    font-weight: 700;
}

#btnPrimary:hover:!disabled {
    background: #2db6a3;
    border-color: #71e1d1;
}

#btnPrimary:pressed:!disabled {
    background: #1b7469;
}

#btnPrimary:disabled {
    background: #15302e;
    border-color: #254a46;
    color: #668c87;
}

#btnDanger {
    background: #7f1d1d;
    border-color: #ef4444;
    color: #ffffff;
    font-weight: 700;
}

#btnDanger:hover:!disabled {
    background: #b91c1c;
    border-color: #f87171;
}

#btnDanger:disabled {
    background: #2a0f16;
    border-color: #4c1d1d;
    color: #7f5563;
}

#btnGhost {
    background: transparent;
    border-color: #32404d;
    color: #a6b4bf;
    font-weight: 600;
}

#btnGhost:hover:!disabled {
    color: #e5ecef;
    border-color: #47606c;
    background: #111820;
}

#btnVerdict {
    background: #111820;
    border-color: #334155;
    color: #cbd5e1;
    font-weight: 600;
}

#btnVerdict:hover:!disabled {
    background: #18232d;
    border-color: #35c7b1;
    color: #ffffff;
}

#btnVerdict:pressed:!disabled {
    background: #14302e;
}

QDialogButtonBox QPushButton {
    min-width: 84px;
}

QDialogButtonBox QPushButton:default {
    background: #229c8b;
    border-color: #35c7b1;
    color: #ffffff;
    font-weight: 700;
}

QDialogButtonBox QPushButton:default:hover:!disabled {
    background: #2db6a3;
}

/* ── Verdict chip (triage detail) ─────────────────────────────────────── */

#verdictChip {
    color: #a6b4bf;
    background: #111820;
    border: 1px solid #32404d;
    border-radius: 10px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 700;
}

#verdictChip[verdict="true_positive"] {
    color: #bbf7d0;
    background: #0f2318;
    border-color: #166534;
}

#verdictChip[verdict="false_positive"] {
    color: #fecdd3;
    background: #2a0f16;
    border-color: #7f1d1d;
}

#verdictChip[verdict="out_of_scope"] {
    color: #fde68a;
    background: #271f0a;
    border-color: #854d0e;
}

#verdictChip[verdict="none"] {
    color: #9fb0c7;
    background: #141b28;
    border-color: #40516b;
}

/* ── Progress ─────────────────────────────────────────────────────────── */

QProgressBar {
    background: #0c1218;
    border: 1px solid #32404d;
    border-radius: 5px;
    color: #d8e2ea;
    text-align: center;
    min-height: 20px;
    font-weight: 600;
}

QProgressBar::chunk {
    background: #229c8b;
    border-radius: 3px;
}

/* ── Tabs ─────────────────────────────────────────────────────────────── */

/* The tab-bar container otherwise paints a light base line with the
   default palette, visible right of the last tab. */
QTabWidget {
    background: transparent;
    border: 0;
}

QTabBar {
    background: transparent;
    border: 0;
    margin: 0;
}

QTabBar::tab {
    background: #111820;
    color: #a6b4bf;
    border: 1px solid #26364c;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    min-width: 70px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #151e27;
    color: #f3f7fa;
    border-color: #26364c;
    border-bottom: 2px solid #35c7b1;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    color: #d8e2ea;
    background: #18232d;
}

QTabWidget::pane {
    border-top: 0;
    background: #111820;
}

/* ── Checkboxes / radios ──────────────────────────────────────────────── */

QCheckBox {
    color: #cbd5e1;
    spacing: 8px;
}

QCheckBox:disabled {
    color: #5b6a80;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #40516b;
    border-radius: 3px;
    background: #0c1218;
}

QCheckBox::indicator:hover {
    border-color: #64748b;
}

QCheckBox::indicator:checked {
    background: #229c8b;
    border-color: #71e1d1;
}

/* No QRadioButton rules: the app uses checkboxes and combos only. A
   radio block here would be dead CSS implying untested coverage. */

/* ── Menus ────────────────────────────────────────────────────────────── */

QMenuBar {
    background: #0c1218;
    color: #a6b4bf;
    border-bottom: 1px solid #25313c;
}

QMenuBar::item {
    padding: 6px 10px;
    background: transparent;
}

QMenuBar::item:selected {
    background: #18232d;
    color: #f3f7fa;
}

QMenu {
    background: #111820;
    border: 1px solid #25313c;
    color: #d8e2ea;
    padding: 4px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 3px;
}

QMenu::item:selected {
    background: #1b7469;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #5b6a80;
}

QMenu::separator {
    height: 1px;
    background: #25313c;
    margin: 4px 8px;
}

/* ── Splitters ────────────────────────────────────────────────────────── */

QSplitter::handle {
    background: #25313c;
}

QSplitter::handle:hover {
    background: #35c7b1;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ── Dialogs & tooltips ───────────────────────────────────────────────── */

QMessageBox, QInputDialog, QFileDialog, QDialog {
    background: #111820;
}

QMessageBox QLabel, QInputDialog QLabel {
    color: #d8e2ea;
}

QToolTip {
    background: #18232d;
    color: #e5ecef;
    border: 1px solid #47606c;
    padding: 5px 8px;
    font-size: 12px;
}

/* ── Assistant readiness ──────────────────────────────────────────────── */

#assistantStatus {
    color: #fecdd3;
    background: #2a0f16;
    border: 1px solid #7f1d1d;
    border-radius: 4px;
    padding: 8px;
}

#assistantStatus[ready="true"] {
    color: #bbf7d0;
    background: #0f2318;
    border-color: #166534;
}

/* ── Nav rail count badges ────────────────────────────────────────────── */

QLabel#navBadge {
    background: #d1495b;
    color: #ffffff;
    border-radius: 7px;
    font-size: 9px;
    font-weight: 800;
    min-width: 14px;
    max-width: 20px;
    padding: 0 2px;
}

/* ── Severity chips (triage filter row) ───────────────────────────────── */

QLabel#severityChip {
    background: #111820;
    border: 1px solid #32404d;
    border-radius: 10px;
    color: #c7d2e0;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 700;
}

QLabel#severityChip:hover {
    border-color: #35c7b1;
    color: #ffffff;
}

QLabel#severityChip[severity="critical"] {
    background: #2a0f16; border-color: #7f1d1d; color: #fecdd3;
}
QLabel#severityChip[severity="high"] {
    background: #271f0a; border-color: #854d0e; color: #fde68a;
}
QLabel#severityChip[severity="medium"] {
    background: #101d2f; border-color: #1d4ed8; color: #bfdbfe;
}
QLabel#severityChip[severity="low"] {
    background: #0f2318; border-color: #166534; color: #bbf7d0;
}
QLabel#severityChip[severity="info"] {
    background: #141b28; border-color: #40516b; color: #9fb0c7;
}

QLabel#severityChip[dim="true"] {
    color: #5b6a80;
    background: #0c1218;
    border-color: #1c2739;
}

/* ── Button focus ring (keyboard operators) ───────────────────────────── */

QPushButton:focus, QToolButton:focus, QCheckBox:focus, QRadioButton:focus {
    border: 1px solid #35c7b1;
    outline: none;
}

/* ── Metric card hover ────────────────────────────────────────────────── */

#metricCard:hover {
    border-color: #47606c;
    background: #151f27;
}

/* ── Intelligence graph workspace ────────────────────────────────────── */

#graphToolbar {
    background: #111820;
    border: 1px solid #25313c;
    border-radius: 7px;
}

#graphSummary {
    color: #e8f0f4;
    font-size: 13px;
    font-weight: 700;
}

#graphLegend {
    color: #93a3b0;
    font-size: 11px;
}

QLineEdit#graphSearch, QComboBox#graphFilter {
    min-height: 22px;
    padding: 6px 9px;
}

QLineEdit#graphSearch {
    border-left: 2px solid #35c7b1;
}

#graphBriefScroll {
    background: #0c1218;
    border: 1px solid #25313c;
    border-radius: 7px;
}

#graphBrief {
    background: #0f161d;
}

#graphBriefTitle {
    color: #70daca;
    font-size: 15px;
    font-weight: 700;
    padding-bottom: 6px;
}

#graphBriefText {
    color: #d8e2ea;
    font-size: 12px;
}

#graphSplitter::handle {
    background: #25313c;
    width: 3px;
}

#graphSplitter::handle:hover {
    background: #35c7b1;
}
